/*
 * Project Theseus — Neo4j Browser GraSS style sheet
 * Load once in Neo4j Browser: :style http://localhost:9621/ui/neo4j-style.grass
 * Persists in browser localStorage. Re-run only after changes here.
 *
 * Entity type groups:
 *   Requirements/deliverables  — amber/yellow
 *   Contract/financial         — emerald/green
 *   Org/people                 — blue
 *   Document/structure         — violet
 *   Proposal/capture           — pink/magenta
 *   Technical/equipment        — cyan/teal
 *   Intelligence/analysis      — orange/red
 *   Regulatory/clauses         — lime
 *   Misc                       — assorted
 */

/* ── Defaults ─────────────────────────────────────────────────────────────── */

node {
  diameter: 44px;
  color: #4B5563;
  border-color: #374151;
  border-width: 2px;
  text-color-internal: #FFFFFF;
  font-size: 9px;
  caption: "{entity_id}";
}

relationship {
  color: #6B7280;
  shaft-width: 1px;
  font-size: 7px;
  padding: 3px;
  text-color-external: #D1D5DB;
  text-color-internal: #FFFFFF;
  caption: "<type>";
}

/* ── Workspace label — defined first so entity-type rules below override it ─
 *
 * Neo4j Browser auto-generates a random style for any label NOT in this file,
 * then appends it at the end — which wins over our entity-type rules.
 * Defining node.swa_tas2 here prevents that auto-generation and lets the
 * later entity-type rules take precedence (CSS last-wins cascade).
 *
 * If you use a different workspace, add node.<workspace> { ... } here too,
 * or hit: :style http://localhost:9621/ui/neo4j-style.grass?ws=<workspace>
 * (dynamic endpoint — see /api/ui/neo4j-style endpoint in ui_routes.py TODO)
 */

node.swa_tas2 {
  color: #1E293B;
  border-color: #0F172A;
  text-color-internal: #64748B;
  font-size: 8px;
  diameter: 38px;
  caption: "{entity_id}";
}

node.ussag_ont {
  color: #1E293B;
  border-color: #0F172A;
  text-color-internal: #64748B;
  font-size: 8px;
  diameter: 38px;
  caption: "{entity_id}";
}

